<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>default</LangVersion>
        <Nullable>annotations</Nullable>
        <AssemblyName>VoxelEngine.ItemDebugger</AssemblyName>
        <RootNamespace>VoxelEngine.ItemDebugger</RootNamespace>
        <!-- Match the game's runtime behavior so the preview is the shipping renderer. -->
        <RollForward>LatestMajor</RollForward>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <TieredPGO>true</TieredPGO>
    </PropertyGroup>

    <ItemGroup>
        <!-- Reuses the engine: content registry, shaders, player rig and item/block mesh caches.
             Referencing the Exe project is deliberate - one source of truth for the renderer. -->
        <ProjectReference Include="..\OpenGLTest\VoxelEngine.csproj" />
    </ItemGroup>

</Project>
