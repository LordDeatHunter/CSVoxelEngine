<Project>
  <!-- Plain `dotnet build` / `dotnet run` build Release. Debug is several times slower in the
       voxel loops and only worth it for breakpoints; pass -c Debug explicitly for that. -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
  </PropertyGroup>
  <!-- Release pdbs record source paths relative to the repo (/_/OpenGLTest/src/...), so a stack
       trace from a shared build shows no builder's local folder. The SDK's CI switch maps the
       compiler paths and the embedded SourceLink table together. Debug keeps the real paths for
       the debugger's source lookup. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
