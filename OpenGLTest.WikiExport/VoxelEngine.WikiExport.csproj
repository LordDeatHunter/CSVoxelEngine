<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>default</LangVersion>
        <Nullable>annotations</Nullable>
        <AssemblyName>VoxelEngine.WikiExport</AssemblyName>
        <RootNamespace>VoxelEngine.WikiExport</RootNamespace>
        <RollForward>LatestMajor</RollForward>
    </PropertyGroup>

    <ItemGroup>
        <!-- Runs the real tree growth engine headlessly and writes the wiki's per-step tree data. -->
        <ProjectReference Include="..\OpenGLTest\VoxelEngine.csproj" />
    </ItemGroup>

</Project>
