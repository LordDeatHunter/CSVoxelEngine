<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>default</LangVersion>
        <Nullable>annotations</Nullable>
        <!-- Lets the net9.0 app run on a newer major runtime (e.g. a 10.x-only
             user-local install in ~/.dotnet) without installing 9.x everywhere. -->
        <RollForward>LatestMajor</RollForward>
        <!-- PERF_TODO item 10: lock the measured runtime behaviour in. Workstation + background
             collections keep Gen2 pauses off the frame path; TieredPGO is the startup/steady-state
             tradeoff the Release measurements were taken with. Server GC deliberately off. -->
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <TieredPGO>true</TieredPGO>
    </PropertyGroup>

    <ItemGroup>
        <!-- The test project drives internal seams (GenerateMeshData(greedy), BakesGreedy, TiledUv) -->
        <InternalsVisibleTo Include="silkgltriangle.Tests" />
        <!-- The item debugger previews mobs the way a client drives them (NetworkSetState) -->
        <InternalsVisibleTo Include="ItemDebugger" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
        <PackageReference Include="Silk.NET.Windowing" Version="2.*" />
        <PackageReference Include="Silk.NET.OpenGL" Version="2.*" />
        <PackageReference Include="StbImageSharp" Version="2.30.15" />
        <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
        <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
        <PackageReference Include="NAudio" Version="2.*" />
        <PackageReference Include="NAudio.WinMM" Version="2.*" />
        <PackageReference Include="NLayer.NAudioSupport" Version="1.*" />
    </ItemGroup>
    <ItemGroup>
        <None Update="assets\shaders\**\*.glsl">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="assets\textures\**\*.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="assets\fonts\**\*.ttf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="assets\sfx\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="assets\**\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="assets\models\**\*.bbmodel">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="assets\models\**\*.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>