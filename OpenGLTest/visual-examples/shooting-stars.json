// Shooting star check (ShootingStar, sky-fragment.glsl). Run from OpenGLTest/ with
//   VOXEL_TIME=600 VOXEL_SCRIPT=visual-examples/shooting-stars.json
// Streaks are deterministic in the star clock (window time + VOXEL_TIME, wrapped hourly) and
// rare (SkyConfig.ShootingStarChance of the 9 s slots), so the camera, flying above the clouds
// and looking high, shoots every half second for 20 s and the streak shows in the few shots that
// land inside its ~0.9 s life and frame its path. To see one at once, raise ShootingStarChance
// (and the arc) temporarily.
{
  "steps": [
    { "op": "fly" },
    { "op": "teleport", "pos": [0.5, 200.5, 0.5], "yaw": 69, "pitch": 62 },
    { "op": "wait", "seconds": 0.5 },
