{
  // World-event effects: run with VOXEL_TIME=147 and VOXEL_SCRIPT=visual-examples/world-events.json
  // from OpenGLTest/. Shots land in visual/world-events/.
  // Particles and blasts are RNG- and frame-rate-driven, so this is a presence check judged by eye,
  // never a pixel instrument.
  //
  // Stands on the flat, bare desert patch torches.json uses (sand at y 9, so the feet are at 10; the
  // desert spawns no mobs of its own). From the eye (253.5, 11.62, -4.5) a ground-top cell centre dz
  // cells ahead is pitch -atan(1.62 / dz) at yaw -90.
  //   tnt-fuse   a TNT block three cells ahead, primed (the `prime` op is a firestarter strike that
  //              never misses), seen from nine blocks back while the 1 s fuse strobes, a goblin two
  //              blocks east of it and a slime two blocks west
  //   tnt-blast  the frames right after the blast: the crater, its loot flung out of it, the goblin and
  //              the slime shoved away from the centre, and the camera shaken off its line (compare
  //              the horizon with tnt-fuse)
  //   sand-settle a sand cube placed against the top of a four-high dirt pillar falls three blocks
  //              and settles in a skirt of its own chips (FallingBlockManager.Landings)
  //   steam      lava poured into the crater and water run down onto it: grey smoke off every cell
  //              that hardens to cobblestone
  //   thud       a forest oak felled at its base hits the ground: a leaf burst off the crown, dust
  //              under the trunk and a camera shake (TopplingTree.TryTakeLanding)
  //   splash     a goblin and then the player dropped into the bay throw pale droplets up off the
  //              water surface (WaterSplash)
  "steps": [
    { "op": "fly", "on": true },
    { "op": "teleport", "pos": [253.5, 30, -4.5], "yaw": -90, "pitch": -28.37 },
    { "op": "wait", "seconds": 14 },
    { "op": "teleport", "pos": [253.5, 11.63, -4.5], "yaw": -90, "pitch": -28.37 },
    { "op": "walk", "keys": ["C"], "seconds": 0.15 },
    { "op": "wait", "seconds": 1.5 },

    // LEG 1 — the fuse, the blast shake and the push.
    { "op": "give", "block": "tnt", "count": 1 },
    { "op": "look", "yaw": -90, "pitch": -28.37 },
    { "op": "place" },
    { "op": "teleport", "pos": [253.5, 11.63, 1.5], "yaw": -90, "pitch": -7.2 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "spawn", "entity": "goblin", "pos": [255.5, 10.0, -7.5] },
    { "op": "spawn", "entity": "slime", "pos": [251.5, 10.3, -7.5] },
    { "op": "prime", "pos": [253, 10, -8] },
    { "op": "wait", "seconds": 0.6 },
    { "op": "screenshot", "name": "tnt-fuse", "hideHud": true },
    { "op": "wait", "seconds": 0.45 },
    { "op": "screenshot", "name": "tnt-blast-a", "hideHud": true },
    { "op": "wait", "seconds": 0.1 },
    { "op": "screenshot", "name": "tnt-blast-b", "hideHud": true },
    { "op": "wait", "seconds": 0.15 },
    { "op": "screenshot", "name": "tnt-blast-c", "hideHud": true },
    { "op": "wait", "seconds": 1.2 },
    { "op": "screenshot", "name": "tnt-after", "hideHud": true },
    { "op": "damage", "amount": 100 },

    // LEG 2 — a sand cube placed against the top of a four-high dirt pillar topples three blocks to
    // the ground beside it and settles in a skirt of its own chips. The camera hovers (flight, so
    // creative) at (254.5, 15.5, 1.5), above the pillar's top, so every placement ray reaches the top
    // face it aims at (x 256, z 1, tops at y 10..13) before any side face, within the first-person
    // ray's ten cells; the sand's aim then meets the finished pillar's west face and puts the sand
    // in the air at (255, 13, 1).
    { "op": "fly", "on": true },
    { "op": "teleport", "pos": [254.5, 15.5, 1.5], "yaw": 0, "pitch": -70.02 },
    { "op": "wait", "seconds": 0.3 },
    { "op": "give", "block": "dirt", "count": 4 },
    { "op": "look", "yaw": 0, "pitch": -70.02 },
    { "op": "place" },
    { "op": "look", "yaw": 0, "pitch": -66.04 },
    { "op": "place" },
    { "op": "look", "yaw": 0, "pitch": -60.26 },
    { "op": "place" },
    { "op": "look", "yaw": 0, "pitch": -51.34 },
    { "op": "place" },
    { "op": "give", "block": "sand", "count": 1 },
    { "op": "look", "yaw": 0, "pitch": -53.13 },
    { "op": "place" },
    // Empty hands, and a side view of the landing cell (255, 10, 1) from six blocks south of it
    { "op": "select", "slot": 9 },
    { "op": "teleport", "pos": [255.5, 12.5, -4.5], "yaw": 90, "pitch": -20 },
    { "op": "wait", "seconds": 0.4 },
    { "op": "screenshot", "name": "sand-settle-a", "hideHud": true },
    { "op": "wait", "seconds": 0.08 },
    { "op": "screenshot", "name": "sand-settle-b", "hideHud": true },
    { "op": "wait", "seconds": 0.1 },
    { "op": "screenshot", "name": "sand-settle-c", "hideHud": true },
    { "op": "wait", "seconds": 0.15 },
    { "op": "screenshot", "name": "sand-settle-d", "hideHud": true },

    // LEG 3 — steam: lava poured into the bottom of the leg 1 crater, then water poured on its slope
    // two blocks east, which runs down onto the lava: every cell that hardens to cobblestone puffs
    // grey smoke (FluidManager.HardenedCells). Each pour looks straight down from a hovering eye.
    { "op": "teleport", "pos": [253.5, 14.5, -7.5], "yaw": 0, "pitch": -89 },
    { "op": "wait", "seconds": 0.3 },
    { "op": "give", "block": "item/lava_bucket" },
    { "op": "place" },
    { "op": "wait", "seconds": 1.0 },
    { "op": "teleport", "pos": [255.5, 14.5, -7.5], "yaw": 0, "pitch": -89 },
    { "op": "wait", "seconds": 0.2 },
    { "op": "give", "block": "item/water_bucket" },
    { "op": "place" },
    { "op": "select", "slot": 8 },
    { "op": "teleport", "pos": [253.5, 10.5, -3.5], "yaw": -90, "pitch": -25 },
    { "op": "wait", "seconds": 0.8 },
    { "op": "screenshot", "name": "steam-a", "hideHud": true },
    { "op": "wait", "seconds": 0.6 },
    { "op": "screenshot", "name": "steam-b", "hideHud": true },
    { "op": "wait", "seconds": 0.6 },
    { "op": "screenshot", "name": "steam-c", "hideHud": true },
    { "op": "wait", "seconds": 1.0 },
    { "op": "screenshot", "name": "steam-d", "hideHud": true },

    // LEG 4 — the tree fall thud: the forest oak trees.json fells, cut at its base from trees.json's
    // own base_aim pose (a single-frame creative mine), tips east, away from the cut; the side view
    // from the south catches it as it hits the ground TreeToppleSeconds (1.2 s) later: a leaf burst
    // off the landed crown, dust kicked up under the trunk, and the camera shaken.
    { "op": "teleport", "pos": [-67.4, 21.0, 3.1], "yaw": -157.5, "pitch": -4.8 },
    { "op": "wait", "seconds": 8 },
    { "op": "teleport", "pos": [-81.5, 15.7, -1.5], "yaw": 0, "pitch": -21.8 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "mine", "seconds": 0.001 },
    { "op": "teleport", "pos": [-74.5, 17.5, 11.5], "yaw": -90, "pitch": -12 },
    { "op": "wait", "seconds": 0.8 },
    { "op": "screenshot", "name": "thud-falling", "hideHud": true },
    { "op": "wait", "seconds": 0.42 },
    { "op": "screenshot", "name": "thud-a", "hideHud": true },
    { "op": "wait", "seconds": 0.12 },
    { "op": "screenshot", "name": "thud-b", "hideHud": true },
    { "op": "wait", "seconds": 0.25 },
    { "op": "screenshot", "name": "thud-c", "hideHud": true },

    // LEG 5 — water splashes in the open sea swim-bubbles.json dives in (the sea surface is y 0.875,
    // over 5 deep at (432.5, 0.5)): a goblin dropped from 6 blocks up throws pale droplets as it hits
    // the water, seen by the hovering camera six blocks away; then the player itself, out of flight and
    // filmed from the shoulder camera, falls in from 7 blocks up. The long wait streams the sea in.
    { "op": "teleport", "pos": [426.5, 4.5, 4.5], "yaw": 0, "pitch": -15 },
    { "op": "wait", "seconds": 14 },
    { "op": "look", "yaw": 0, "pitch": -15 },
    { "op": "spawn", "entity": "goblin", "pos": [432.5, 7.0, 4.5] },
    { "op": "wait", "seconds": 0.55 },
    { "op": "screenshot", "name": "splash-goblin-a", "hideHud": true },
    { "op": "wait", "seconds": 0.08 },
    { "op": "screenshot", "name": "splash-goblin-b", "hideHud": true },
    { "op": "wait", "seconds": 0.1 },
    { "op": "screenshot", "name": "splash-goblin-c", "hideHud": true },
    { "op": "damage", "amount": 100 },
    { "op": "fly", "on": false },
    { "op": "view", "mode": "shoulder" },
    { "op": "teleport", "pos": [432.5, 8.5, 0.5], "yaw": 0, "pitch": -25 },
    { "op": "wait", "seconds": 0.66 },
    { "op": "screenshot", "name": "splash-player-a", "hideHud": true },
    { "op": "wait", "seconds": 0.08 },
    { "op": "screenshot", "name": "splash-player-b", "hideHud": true },
    { "op": "wait", "seconds": 0.1 },
    { "op": "screenshot", "name": "splash-player-c", "hideHud": true }
  ]
}
