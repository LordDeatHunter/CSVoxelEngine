// Godrays check (Godrays, GodraysRenderer, godrays-fragment.glsl): light shafts through trees,
// clouds and gaps when the sun is in view. Run from OpenGLTest/, once per time, copying
// visual/godrays/ aside between runs:
//   $env:VOXEL_SCRIPT='visual-examples/godrays.json'; $env:VOXEL_TIME='<t>'
//   bin/Release/net9.0/VoxelEngine.exe
// Times: 395 (the shots land ~15-25 s in, a low sun near the shafts' peak at yaw ~160, pitch ~11:
// the meadow and over-canopy shots show beams fanning from the sun through the cloud gaps and over
// the tree line), 425 (the sun reaches the horizon behind the trees during the run: the shafts
// fade out with it), 147 (noon, overhead at yaw 90: a fraction of the low-sun strength).
// $env:VOXEL_DEBUG='1' adds the profiler lines with the godPass row to the log.
// The wood west of the origin (a headless probe on WorldSeed.Default: ground 12 at (-40, -20)
// under a canopy dense enough that a low sun casts no shafts inside it), flying so the poses hold.
{
  "steps": [
    { "op": "wait", "seconds": 12 },
    { "op": "fly" },
    // On the forest floor, toward the sun through the trunks and crowns.
    { "op": "teleport", "pos": [-40.5, 14.5, -20.5], "yaw": 160, "pitch": 8 },
    { "op": "wait", "seconds": 3 },
    { "op": "screenshot", "name": "toward_sun", "hideHud": true },
    { "op": "teleport", "pos": [-40.5, 14.5, -20.5], "yaw": 160, "pitch": 22 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "toward_sun_up", "hideHud": true },
    // A meadow toward the low sun (low-health.json's clearing): beams fan out from the sun through
    // the cloud gaps and down over the far tree line.
    { "op": "teleport", "pos": [-43.5, 12.5, 62.5], "yaw": 160, "pitch": 6 },
    { "op": "wait", "seconds": 2 },
    { "op": "screenshot", "name": "meadow", "hideHud": true },
    // Just over the canopy: shafts between the crowns.
    { "op": "teleport", "pos": [-40.5, 30.5, -20.5], "yaw": 160, "pitch": 0 },
    { "op": "wait", "seconds": 1 },
    { "op": "screenshot", "name": "over_canopy", "hideHud": true },
    // Turned away from the sun: no shafts.
    { "op": "teleport", "pos": [-40.5, 14.5, -20.5], "yaw": -20, "pitch": 8 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "away", "hideHud": true },
    // Straight up through the canopy, toward the noon sun.
    { "op": "teleport", "pos": [-40.5, 14.5, -20.5], "yaw": 90, "pitch": 60 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "up", "hideHud": true },
    // A hold toward the sun, long enough for a couple of profiler lines with VOXEL_DEBUG=1.
    { "op": "teleport", "pos": [-40.5, 14.5, -20.5], "yaw": 160, "pitch": 8 },
    { "op": "wait", "seconds": 4 },
    { "op": "screenshot", "name": "hold", "hideHud": true }
  ]
}
