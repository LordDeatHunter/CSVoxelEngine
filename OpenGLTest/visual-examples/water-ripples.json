    { "op": "wait", "seconds": 6 },
    { "op": "fly" },
    { "op": "teleport", "pos": [432.5, 6.0, 7.5], "yaw": -90, "pitch": -30 },
    { "op": "wait", "seconds": 1 },
    { "op": "spawn", "entity": "goblin", "pos": [432.5, 6.0, 0.5] },
