// Sky dome check (SH-11/SH-21). Run from OpenGLTest/, once per time of day, copying
// visual/sky/ aside between runs since each run overwrites it:
//   $env:DOTNET_ROLL_FORWARD='LatestMajor'; $env:VOXEL_SCRIPT='visual-examples/sky.json';
//   $env:VOXEL_TIME='<t>'; ~/.dotnet/dotnet.exe run --project VoxelEngine.csproj -c Release
// Times: 147 noon, 440 sunset, 700 night, 1040 sunrise.
// Yaw theta faces (cos theta, sin theta) in XZ and the sun travels along
// normalize(cos a, sin a, 0.35), so at 440 the setting sun sits near yaw 160 and at 1040 the
// rising sun near yaw 20: sky_sunset_side / sky_sunrise_side look at it, sky_sunset_away
// looks directly away from the sunset.
// Camera.IsEyeInWater and the physics only update during wait/walk/mine (never on a
// teleport, look or screenshot), so every shot after a teleport is preceded by a wait.
{
  "steps": [
    // (A) underwater, grounded exactly as water.json frames it: the Snell window must still
    // show the dry sky dome through the surface.
    { "op": "wait", "seconds": 5 },
    { "op": "walk", "keys": ["Space"], "seconds": 0.05 },
    { "op": "wait", "seconds": 0.12 },
    { "op": "walk", "keys": ["Space"], "seconds": 0.05 },
    { "op": "teleport", "pos": [360.5, -3.5, 136.5], "yaw": 90, "pitch": 80 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "sky_snell_window", "hideHud": true },

    // (B) the dome itself, flying high over the origin so the pose holds.
    { "op": "fly" },
    { "op": "teleport", "pos": [0.5, 140.5, 0.5], "yaw": 160, "pitch": 3 },
    { "op": "wait", "seconds": 3 },
    { "op": "screenshot", "name": "sky_sunset_side", "hideHud": true },
    { "op": "teleport", "pos": [0.5, 140.5, 0.5], "yaw": -20, "pitch": 3 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "sky_sunset_away", "hideHud": true },
    { "op": "teleport", "pos": [0.5, 140.5, 0.5], "yaw": 20, "pitch": 3 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "sky_sunrise_side", "hideHud": true },
    { "op": "teleport", "pos": [0.5, 140.5, 0.5], "yaw": -90, "pitch": 45 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "sky_gradient_up", "hideHud": true },
    // High enough that the LOD rings' far edge meets the horizon in frame.
    { "op": "teleport", "pos": [0.5, 320.5, 0.5], "yaw": 160, "pitch": -6 },
    { "op": "wait", "seconds": 3 },
    { "op": "screenshot", "name": "sky_lod_edge", "hideHud": true },

    // (C) the mirror, over the same open-ocean column the Snell window shot uses (the floor
    // there is at -8, sea level 0), still flying so the eye holds above the surface. A shallow
    // look keeps the fresnel high so the reflected dome reads; yaw 110 faces open sea.
    { "op": "teleport", "pos": [360.5, 3.5, 136.5], "yaw": 110, "pitch": -5 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "sky_mirror", "hideHud": true }
  ]
}
