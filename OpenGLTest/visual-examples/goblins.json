{
  // Goblins: run with VOXEL_SCRIPT=visual-examples/goblins.json VOXEL_TIME=147 from OpenGLTest/.
  // Shots land in visual/goblins/.
  // `spawn` takes an entity name and either [x, z] (feet snapped onto the terrain column) or
  // [x, y, z] (an exact feet position).
  // `fly` makes the camera immune (creative flight), so the goblins throw their flint and then
  // charge, but never deal damage and the camera never gets knocked about between shots.
  // The camera hovers just above standing height over an open, flat, dry forest clearing
  // (ground at y 9..10 over x -56..-32, z 32..68, no trunks) facing -Z, and both goblins stand
  // 8-10 blocks in front of it, inside the 4-12 block throw band. The plan's first choice,
  // basic.json's "plain" spot at [48.5, 90.5, 48.5], turned out to hang ~80 blocks over a dense
  // canopy under this seed, where the goblins vanished under the leaves.
  // The "windup" shot is best-effort: it is timed for the 1 s first-throw delay
  // (GoblinFirstThrowDelaySeconds) plus about 0.2 s into the throw clip's wind-up. A stone in
  // flight in "stones" depends on the cooldown jitter; by "charge" the goblins have usually
  // thrown everything and closed in.
  "steps": [
    { "op": "teleport", "pos": [-43.5, 13.5, 60.5], "yaw": -90, "pitch": -8 },
    { "op": "fly" },
    // Chunks must be loaded before anything can stand on them: a goblin reads an unloaded
    // chunk as air and would fall through.
    { "op": "wait", "seconds": 5 },
    { "op": "spawn", "entity": "goblin", "pos": [-43.5, 52.5] },
    { "op": "spawn", "entity": "goblin", "pos": [-40.5, 50.5] },
    { "op": "wait", "seconds": 1.2 },
    { "op": "screenshot", "name": "windup" },
    { "op": "wait", "seconds": 3 },
    { "op": "screenshot", "name": "stones" },
    { "op": "wait", "seconds": 8 },
    // Out of stones they close to melee standoff right under the hovering camera, so look down.
    { "op": "look", "yaw": -90, "pitch": -55 },
    { "op": "screenshot", "name": "charge" }
  ]
}
