{
  // Shared mob hazards: run with VOXEL_SCRIPT=visual-examples/mob-hazards.json VOXEL_TIME=147 from
  // OpenGLTest/. Shots land in visual/mob-hazards/.
  // The camera hovers (flying makes it immune to the goblins' stones) and watches each mob's
  // healthbar of five hearts.

  "steps": [
    { "op": "wait", "seconds": 12 },
    { "op": "fly" },

    // FALL DAMAGE (MobFallDamage): the flat desert chunk of ground-dust.json (ground top y 10 at
    // x 168, z 136). Facing +X, the left goblin drops one block and keeps all its hearts; the right
    // one drops eight and lands with most of them gone, red with the hit flash.
    { "op": "teleport", "pos": [163.5, 13.5, 136.5], "yaw": 0, "pitch": -8 },
    { "op": "wait", "seconds": 1.5 },
    { "op": "spawn", "entity": "goblin", "pos": [169.5, 12.0, 134.5] },
    { "op": "spawn", "entity": "goblin", "pos": [169.5, 19.0, 138.5] },
    { "op": "wait", "seconds": 0.85 },
    { "op": "screenshot", "name": "goblin-fall" },
    // LOOT TOSS (MobLoot): both goblins killed at once; their loot and carried flint arc up and
    // out of the bodies instead of appearing at their feet
    { "op": "damage", "amount": 100 },
    { "op": "wait", "seconds": 0.2 },
    { "op": "screenshot", "name": "loot-toss" },
    // A size-2 slime dropped nine blocks (past its own hop's apex) loses hearts too
    { "op": "wait", "seconds": 0.8 },
    { "op": "spawn", "entity": "slime", "pos": [169.5, 20.0, 136.5], "size": 2 },
    { "op": "wait", "seconds": 0.9 },
    { "op": "screenshot", "name": "slime-fall" },

    // LAVA (MobLava, Mob.UpdateHazards): the generated lava lake of lava.json around (-65, -45, 70).
    // A goblin and a slime dropped into it flash red and lose hearts tick by tick, then die.
    { "op": "damage", "amount": 100 },
    { "op": "teleport", "pos": [-64.5, -41.5, 74.5], "yaw": -90, "pitch": -40 },
    { "op": "wait", "seconds": 10 },
    { "op": "screenshot", "name": "lava-before" },
    { "op": "spawn", "entity": "goblin", "pos": [-65.5, -43.0, 70.5] },
    { "op": "spawn", "entity": "slime", "pos": [-63.0, -43.0, 70.5] },
    { "op": "wait", "seconds": 1.3 },
    { "op": "screenshot", "name": "lava-burn" },
    { "op": "wait", "seconds": 1.2 },
    { "op": "screenshot", "name": "lava-burn-later" },

    // DESPAWN FADE: a giant on the desert flat, then the camera jumps 66 blocks back (past the
    // despawn radius) while still watching it from above: it balloons and shrinks away through its
    // death pose, dropping nothing, instead of blinking out.
    { "op": "damage", "amount": 100 },
    { "op": "teleport", "pos": [160.5, 18.0, 136.5], "yaw": 0, "pitch": -20 },
    { "op": "wait", "seconds": 4 },
    { "op": "spawn", "entity": "slime", "pos": [169.5, 136.5], "size": 4 },
    { "op": "wait", "seconds": 0.6 },
    { "op": "screenshot", "name": "despawn-before" },
    { "op": "teleport", "pos": [103.5, 40.0, 136.5], "yaw": 0, "pitch": -18 },
    { "op": "wait", "seconds": 0.12 },
    { "op": "screenshot", "name": "despawn-fading" },
    { "op": "wait", "seconds": 0.6 },
    { "op": "screenshot", "name": "despawn-gone" }
  ]
}
