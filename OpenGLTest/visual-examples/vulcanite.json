{
  // Vulcanite check (VulcaniteGenerator): run from OpenGLTest/ with
  //   VOXEL_TIME=147 VOXEL_SCRIPT=visual-examples/vulcanite.json
  // Shots land in visual/vulcanite/. Vulcanite veins basalt only (the barrier band and the Magma Caverns'
  // skin), and its threshold drops near lava, so the veins gather in the basalt by the pools.
  // First a reference under the noon sun on iron.json's flat frozen plain ((-1112, 584), ground 18): a
  // vulcanite_ore block (left) beside a magma_block (right), the Magma Caverns' glowing floor and pool bed,
  // so the ore's tile (dark rock with red crystals) is known and told apart from magma before looking for it.
  // Then hell.json's Magma Caverns spot at layer 1 (its lava level sits at y -562, about 12 blocks under
  // the camera): basalt floors and walls over lava pools, the vulcanite in the basalt nearest the lava
  // (magma blocks line the pool beds too, so compare with the reference), and a steep look up at the
  // basalt high above the lava, where the ore should be all but absent (the red fog may hide a far ceiling).
  // The barrier band is not filmed: barrier.json's cavern spots were moved 100 blocks down with the band
  // without a rescan and now sit in solid rock (the camera sees only void there).
  "steps": [
    { "op": "fly", "on": true },
    { "op": "teleport", "pos": [-1111.5, 50.5, 584.5], "yaw": -90, "pitch": -30 },
    { "op": "wait", "seconds": 16 },
    { "op": "teleport", "pos": [-1111.5, 21.4, 584.5], "yaw": -90, "pitch": -31 },
    { "op": "wait", "seconds": 1 },

    { "op": "give", "block": "vulcanite_ore", "count": 1 },
    { "op": "look", "yaw": -97, "pitch": -31 },
    { "op": "place" },
    { "op": "give", "block": "magma_block", "count": 1 },
    { "op": "look", "yaw": -83, "pitch": -31 },
    { "op": "place" },
    // An empty hotbar slot keeps the first-person held block out of the shots
    { "op": "select", "slot": 9 },
    { "op": "wait", "seconds": 0.5 },

    { "op": "teleport", "pos": [-1111.5, 22.0, 583.0], "yaw": -90, "pitch": -24 },
    { "op": "wait", "seconds": 1 },
    { "op": "screenshot", "name": "reference_ore", "hideHud": true },

    // Creative keeps the lava from hurting the camera in hell
    { "op": "creative", "on": true },
    { "op": "teleport", "pos": [-23.5, -549.4, 8.5], "yaw": 0, "pitch": -15 },
    { "op": "wait", "seconds": 20 },
    { "op": "screenshot", "name": "magma_ahead", "hideHud": true },
    { "op": "look", "yaw": 0, "pitch": -50 },
    { "op": "screenshot", "name": "magma_shore", "hideHud": true },
    { "op": "look", "yaw": 0, "pitch": 65 },
    { "op": "screenshot", "name": "magma_high", "hideHud": true }
  ]
}
