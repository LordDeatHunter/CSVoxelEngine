// Sealed-room ambient check (SkyAmbient): the unlit cave tunnel of eye-adaptation.json, filmed once the eye has
// adapted, plus an open-sky control. Run twice from OpenGLTest/, VOXEL_TIME=255 (day) and VOXEL_TIME=1454 (night; DayLengthSeconds is 2400, so 2655 is the same sun as 255),
// baseline and fixed build: the outdoor shots must differ. The cave shots carry glow mushrooms, whose block-light flicker follows the lighting clock,
// so they need not match; sealed-room.json is the clean zero-skylight check.
{
  "steps": [
    { "op": "wait", "seconds": 5 },
    { "op": "fly" },
    { "op": "teleport", "pos": [55.5, -11.5, -73.5], "yaw": -90, "pitch": -5 },
    { "op": "wait", "seconds": 14 },
    { "op": "screenshot", "name": "cave_adapted", "hideHud": true },
    { "op": "teleport", "pos": [0.5, 90.5, 0.5], "yaw": -90, "pitch": -20 },
    { "op": "wait", "seconds": 6 },
    { "op": "screenshot", "name": "outside", "hideHud": true }
  ]
}
