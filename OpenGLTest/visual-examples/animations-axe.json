{
  // The axe's chop at the oak trees.json films (full-thickness trunk cell at (-79, 14, -2), hardness
  // 24, so the primitive axe's 1.0 per 0.3 s takes about 7 s): run with
  // VOXEL_SCRIPT=visual-examples/animations-axe.json VOXEL_TIME=147 from OpenGLTest/. Shots land in
  // visual/animations-axe/. The player hovers while the chunks load, then drops to the ground and
  // stands in survival 2.5 blocks south of the trunk facing it and
  // really mines it, so each hit shows the swing, the chips off the trunk, the camera nudge and a few
  // leaves shaken loose from the crown and a notch that deepens in the trunk (the deep_cut shots, taken
  while the chop is still held: the notch heals when the button is released). The wind-up starts ahead of each hit, so every shot after the
  // first hit catches the blade on its way down as the hit lands. Shots are approximate (a frame or
  // two after their wait); the last one is the trunk after the tree came down.
  "steps": [
    { "op": "fly" },
    { "op": "teleport", "pos": [-78.5, 15.7, -4.5], "yaw": 90, "pitch": -5 },
    { "op": "wait", "seconds": 6 },
    { "op": "damage", "amount": 1000 },
    { "op": "creative", "on": false },
    { "op": "wait", "seconds": 1 },
    { "op": "give", "block": "item/primitive_axe", "count": 1 },
    { "op": "select", "slot": 1 },
    { "op": "view", "mode": "shoulder" },
    { "op": "wait", "seconds": 1 },
    { "op": "screenshot", "name": "ready", "hideHud": true },
    { "op": "mine", "seconds": 0.05 },
    { "op": "wait", "seconds": 0.1 },
