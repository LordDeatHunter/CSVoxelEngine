    { "op": "screenshot", "name": "chop_a", "hideHud": true },
    { "op": "mine", "seconds": 0.12 },
    { "op": "screenshot", "name": "chop_b", "hideHud": true },
    { "op": "mine", "seconds": 0.12 },
    { "op": "screenshot", "name": "chop_c", "hideHud": true },
    { "op": "view", "mode": "first" },
    { "op": "mine", "seconds": 0.7 },
