    { "op": "place" },
    { "op": "look", "yaw": -100, "pitch": -30 },
    { "op": "wait", "seconds": 1 },
    { "op": "screenshot", "name": "trapdoors-closed", "hideHud": true },

    { "op": "look", "yaw": -108.43, "pitch": -24.34 },
    { "op": "place" },
    { "op": "look", "yaw": -100, "pitch": -30 },
    { "op": "wait", "seconds": 0.5 },
