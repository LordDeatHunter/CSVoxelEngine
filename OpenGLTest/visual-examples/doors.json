{
  // Trapdoor check: run with VOXEL_TIME=147 (noon) and VOXEL_SCRIPT=visual-examples/doors.json.
  // Shots land in visual/doors/.
  //
  // The flat desert patch of torches.json: the player hovers at (253, -5) (sand at y 9, feet at
  // 10, eye (253.5, 11.62, -4.5)) and every placement aims at an exact cell, written relative to
  // the player's cell as (dx, y, dz): a ground cell centre (dx, 9, dz) is yaw atan2(dz, dx),
  // pitch -atan(1.62 / |(dx, dz)|). The place op is the right-click: aimed at an openable block
  // it opens or closes it instead of placing anything.
  //   Two oak trapdoors on the ground, both placed looking (mostly) north: (-1, 10, -3) and
  //   (0, 10, -2).
  //   trapdoors-closed  both lying shut on the sand
  //   trapdoors-open    the far one clicked open: it stands up against the side of its cell
  //                     nearest the camera, the near one stays shut
  //   trapdoors-oblique the same from the front left
  "steps": [
    { "op": "fly", "on": true },
    { "op": "teleport", "pos": [253.5, 30, -4.5], "yaw": -90, "pitch": -30 },
    { "op": "wait", "seconds": 14 },
    { "op": "teleport", "pos": [253.5, 11.63, -4.5], "yaw": -90, "pitch": -30 },
    { "op": "wait", "seconds": 1 },

    { "op": "give", "block": "oak_trapdoor", "count": 2 },
    { "op": "look", "yaw": -108.43, "pitch": -27.13 },
    { "op": "place" },
    { "op": "look", "yaw": -90, "pitch": -39.0 },
    { "op": "place" },
    { "op": "look", "yaw": -100, "pitch": -30 },
    { "op": "wait", "seconds": 1 },
    { "op": "screenshot", "name": "trapdoors-closed", "hideHud": true },

    { "op": "look", "yaw": -108.43, "pitch": -24.34 },
    { "op": "place" },
    { "op": "look", "yaw": -100, "pitch": -30 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "trapdoors-open", "hideHud": true },
    { "op": "teleport", "pos": [250.5, 12.5, -3.5], "yaw": -50, "pitch": -25 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "trapdoors-oblique", "hideHud": true }
  ]
}
