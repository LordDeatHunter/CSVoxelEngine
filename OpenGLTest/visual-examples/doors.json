  // Trapdoor and door check: run with VOXEL_TIME=147 (noon) and VOXEL_SCRIPT=visual-examples/doors.json.
  // Shots land in visual/doors/.
  //
  // The flat desert patch of torches.json: the player hovers at (157, 283) (sand at y 11, feet at
  // 12, eye (157.5, 13.62, 283.5)) and every placement aims at an exact cell, written relative to
  // the player's cell as (dx, y, dz): a ground cell center (dx, 11, dz) is yaw atan2(dz, dx),
  // pitch -atan(1.62 / |(dx, dz)|). The place op is the right-click: aimed at an openable block
  // it opens or closes it instead of placing anything.
  //   Two oak trapdoors on the ground, both placed looking (mostly) north: (-1, 12, -3) and
  //   (0, 12, -2).
  //   trapdoors-closed  both lying shut on the sand
  //   trapdoors-open    the far one clicked open: it stands up against the side of its cell
  //                     nearest the camera, the near one stays shut
  //   trapdoors-oblique the same from the front left
  //   Then two oak doors, both placed looking (mostly) north from the start: (1, 12, -3) and
  //   (2, 12, -3), each two cells tall, the panel across the side of its cell nearest the camera.
  //   doors-closed      both shut side by side, windows over their upper halves
  //   doors-one-open    the right one clicked open on its upper half: both halves swing together
  //                     a quarter turn about the left-hand hinge, into the cell
  //   doors-oblique     the same from the front right
  "steps": [
    { "op": "fly", "on": true },
    { "op": "teleport", "pos": [157.5, 32, 283.5], "yaw": -90, "pitch": -30 },
    { "op": "wait", "seconds": 14 },
    { "op": "teleport", "pos": [157.5, 13.63, 283.5], "yaw": -90, "pitch": -30 },
    { "op": "wait", "seconds": 1 },

    { "op": "give", "block": "oak_trapdoor", "count": 2 },
