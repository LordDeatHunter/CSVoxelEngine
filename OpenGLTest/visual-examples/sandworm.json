{
  // Sandworm check (plans/SANDWORM.md): run from OpenGLTest/ at noon
  //   $env:VOXEL_SCRIPT='visual-examples/sandworm.json'; $env:VOXEL_TIME='147'
  //   bin/Release/net9.0/VoxelEngine.exe
  // The deep desert of biome-grade.json at (256, 0), ground 9. A flying (so immune, but still hunted) camera
  // hovers 6 blocks over the sand looking east; the worm spawns burrowed 20 blocks ahead and is filmed every 0.6 s:
  // the thump (sand and a rumble), the dig with sand churning at its surfacing point, the breach, the air,
  // then a dive or a dash, and so on round again. Shots land in visual/sandworm/.
  "steps": [
    { "op": "creative", "on": true },
    { "op": "fly", "on": true },
    { "op": "teleport", "pos": [256.5, 16.5, 0.5], "yaw": 0, "pitch": -6 },
    { "op": "wait", "seconds": 14 },
    { "op": "spawn", "entity": "sandworm", "pos": [276.5, 0.5] },
    { "op": "wait", "seconds": 0.6 },
    { "op": "screenshot", "name": "t00", "hideHud": true },
    { "op": "wait", "seconds": 0.6 },
