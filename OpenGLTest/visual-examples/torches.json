{
  // Torch check: run with VOXEL_TIME=700 (night) and VOXEL_SCRIPT=visual-examples/torches.json.
  // Shots land in visual/torches/.
  //
  // Stands on a flat, bare patch of desert at (253, -5) (sand at y 9, so the feet are at 10; the
  // desert spawns no mobs, so nothing shoves the player off its marks) and aims every placement
  // at an exact cell: from the eye (253.5, 11.62, -4.5) a cell centre (dx, 0, dz) away on the
  // ground top is yaw atan2(dz, dx), pitch -atan(1.62 / |(dx, dz)|). The first-person ray walks
  // at most ten cells, so every target stays within that many DDA steps of the eye.
  //   floor-close  three floor torches two cells ahead: thin posts with bright tops, warm pools
  //   drop         a dirt block five cells ahead with a torch on top, mined from its side: the
  //                torch pops and lies on the ground beside the dirt drop (out of pickup range)
  //   wall-front   two two-high dirt pillars four cells ahead (x 251 and 255): wall torches on
  //                the facing sides of their tops (leaning toward each other) and on the near
  //                sides of their feet (leaning toward the camera)
  //   wall-mined   the left pillar's top mined: the torch on its side drops, the torch on the
  //                foot below stays (it hangs on the foot, not on the block above it)
  //   wall-oblique the pillars from the front left, where the lean of each torch shows
  //   floor-pools  the pools from above, overlapping without block-sized seams
  //   flame-floor, flame-wall  close shots of a floor and a wall torch: a flicker of embers over
  //                each head and a thin wisp of smoke (the "flame" block field)
  // The player hovers over the patch until it streams in, then drops out of creative with C so
  // the mined blocks drop (flight left creative on).
  "steps": [
    { "op": "fly", "on": true },
    { "op": "teleport", "pos": [253.5, 30, -4.5], "yaw": -90, "pitch": -39 },
    { "op": "wait", "seconds": 14 },
    { "op": "teleport", "pos": [253.5, 11.63, -4.5], "yaw": -90, "pitch": -39 },
    { "op": "walk", "keys": ["C"], "seconds": 0.15 },
    { "op": "wait", "seconds": 1.5 },

    { "op": "give", "block": "torch", "count": 8 },
    { "op": "look", "yaw": -90, "pitch": -39.0 },
    { "op": "place" },
    { "op": "look", "yaw": -135, "pitch": -29.8 },
    { "op": "place" },
    { "op": "look", "yaw": -45, "pitch": -29.8 },
    { "op": "place" },
    { "op": "look", "yaw": -90, "pitch": -30 },
    { "op": "wait", "seconds": 1 },
    { "op": "screenshot", "name": "floor-close" },

    { "op": "give", "block": "dirt", "count": 1 },
    { "op": "look", "yaw": -90, "pitch": -17.95 },
    { "op": "place" },
    { "op": "give", "block": "torch", "count": 1 },
    { "op": "look", "yaw": -90, "pitch": -6.8 },
    { "op": "place" },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "on-dirt", "hideHud": true },
    { "op": "look", "yaw": -90, "pitch": -13.97 },
    { "op": "mine", "seconds": 3.0 },
    { "op": "wait", "seconds": 0.4 },
    { "op": "screenshot", "name": "drop", "hideHud": true },

    { "op": "give", "block": "dirt", "count": 4 },
    { "op": "look", "yaw": -116.57, "pitch": -19.91 },
    { "op": "place" },
    { "op": "look", "yaw": -116.57, "pitch": -7.89 },
    { "op": "place" },
    { "op": "look", "yaw": -63.43, "pitch": -19.91 },
    { "op": "place" },
    { "op": "look", "yaw": -63.43, "pitch": -7.89 },
    { "op": "place" },
    { "op": "give", "block": "torch", "count": 4 },
    { "op": "look", "yaw": -110.56, "pitch": -1.61 },
    { "op": "place" },
    { "op": "look", "yaw": -69.44, "pitch": -1.61 },
    { "op": "place" },
    { "op": "look", "yaw": -119.74, "pitch": -15.53 },
    { "op": "place" },
    { "op": "look", "yaw": -60.26, "pitch": -15.53 },
    { "op": "place" },
    { "op": "look", "yaw": -90, "pitch": -8 },
    { "op": "wait", "seconds": 1 },
    { "op": "screenshot", "name": "wall-front" },
    { "op": "look", "yaw": -119.74, "pitch": -0.28 },
    { "op": "mine", "seconds": 3.0 },
    { "op": "wait", "seconds": 0.4 },
    { "op": "look", "yaw": -90, "pitch": -8 },
    { "op": "wait", "seconds": 0.2 },
    { "op": "screenshot", "name": "wall-mined", "hideHud": true },

    { "op": "fly", "on": true },
    { "op": "teleport", "pos": [248.5, 12.2, -4.5], "yaw": -38.66, "pitch": -10.6 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "wall-oblique", "hideHud": true },
    { "op": "teleport", "pos": [253.5, 19.5, 0.5], "yaw": -90, "pitch": -45 },
    { "op": "wait", "seconds": 1 },
    { "op": "screenshot", "name": "floor-pools", "hideHud": true },

    // Torch flames (World's torch fire instance, fed by each block's "flame" point through
    // Chunk.FlamePoints), close up with empty hands: the middle floor torch two cells ahead (head
    // flame at (253.5, 10.66, -6.5)) and the right pillar's foot torch, facing south (flame at
    // (255.5, 10.83, -7.75)), from its front right, where its lean shows. Embers flicker just over
    // each head and a thin wisp of smoke rises off it.
    { "op": "select", "slot": 10 },
    { "op": "teleport", "pos": [253.5, 11.0, -5.3], "yaw": -90, "pitch": -16 },
    { "op": "wait", "seconds": 1.5 },
    { "op": "screenshot", "name": "flame-floor", "hideHud": true },
    { "op": "teleport", "pos": [256.4, 11.1, -6.8], "yaw": -133.5, "pitch": -12 },
    { "op": "wait", "seconds": 1.5 },
    { "op": "screenshot", "name": "flame-wall", "hideHud": true }
  ]
}
