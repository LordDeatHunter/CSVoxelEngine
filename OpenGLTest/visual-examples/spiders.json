{
  // Giant spider check: run from OpenGLTest/ with
  //   VOXEL_TIME=147 VOXEL_SCRIPT=visual-examples/spiders.json
  // Shots land in visual/spiders/. The camera hovers (creative flight, so it is immune and the spiders still
  // chase it). First on the surface at the spawn: a spider five blocks ahead walks up over the terrain, its
  // legs stepping onto whatever blocks are there, and bites. Then the camera hovers over a short stone pillar it
  // lays under itself, and a second spider walks up to the pillar, climbs its side and rounds its top edge. Then
  // in the fungal cave spot of cave-mobs.json (three lamps for light): a spider and then the broodmother. The
  // [x, z] form of `spawn` snaps onto the surface; the cave spawns give exact feet.
  "steps": [
    { "op": "creative", "on": true },
    { "op": "fly", "on": true },
    { "op": "wait", "seconds": 12 },

    { "op": "look", "yaw": -90, "pitch": -25 },
    { "op": "spawn", "entity": "spider", "pos": [0.5, -5.5] },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "surface_spawned", "hideHud": true },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "surface_walk_a", "hideHud": true },
    { "op": "wait", "seconds": 0.4 },
    { "op": "screenshot", "name": "surface_walk_b", "hideHud": true },
    { "op": "wait", "seconds": 1.5 },
    { "op": "look", "yaw": -90, "pitch": -70 },
    { "op": "wait", "seconds": 0.3 },
    { "op": "screenshot", "name": "surface_under", "hideHud": true },
    { "op": "view", "mode": "shoulder" },
    { "op": "wait", "seconds": 0.5 },
    { "op": "screenshot", "name": "surface_bite", "hideHud": true },
    { "op": "damage", "amount": 999 },
    { "op": "wait", "seconds": 0.45 },
    { "op": "screenshot", "name": "surface_death", "hideHud": true },
    { "op": "view", "mode": "first" },

    { "op": "teleport", "pos": [0.5, 17.5, 4.5], "yaw": -90, "pitch": -89 },
    { "op": "wait", "seconds": 0.5 },
    { "op": "give", "block": "stone", "count": 8 },
    { "op": "place" },
    { "op": "wait", "seconds": 0.2 },
    { "op": "place" },
    { "op": "wait", "seconds": 0.2 },
    { "op": "place" },
    { "op": "select", "slot": 9 },
    { "op": "look", "yaw": -90, "pitch": -62 },
    { "op": "spawn", "entity": "spider", "pos": [0.5, -1.5] },
    { "op": "wait", "seconds": 1.2 },
    { "op": "screenshot", "name": "pillar_a", "hideHud": true },
    { "op": "wait", "seconds": 0.35 },
    { "op": "screenshot", "name": "pillar_b", "hideHud": true },
    { "op": "wait", "seconds": 0.35 },
    { "op": "screenshot", "name": "pillar_c", "hideHud": true },
    { "op": "look", "yaw": -90, "pitch": -80 },
    { "op": "wait", "seconds": 0.3 },
    { "op": "screenshot", "name": "pillar_d", "hideHud": true },
    { "op": "wait", "seconds": 0.3 },
    { "op": "screenshot", "name": "pillar_e", "hideHud": true },
    { "op": "wait", "seconds": 0.3 },
    { "op": "screenshot", "name": "pillar_f", "hideHud": true },
    { "op": "view", "mode": "shoulder" },
    { "op": "wait", "seconds": 0.4 },
    { "op": "screenshot", "name": "pillar_g", "hideHud": true },
    { "op": "wait", "seconds": 0.6 },
    { "op": "screenshot", "name": "pillar_h", "hideHud": true },
    { "op": "damage", "amount": 999 },
    { "op": "view", "mode": "first" },

    { "op": "teleport", "pos": [3.5, -219.38, 3.5], "yaw": -90, "pitch": -20 },
    { "op": "wait", "seconds": 24 },
    { "op": "give", "block": "lamp", "count": 32 },
    { "op": "look", "yaw": -90, "pitch": -89 },
    { "op": "place" },
    { "op": "look", "yaw": 0, "pitch": 0 },
    { "op": "place" },
    { "op": "look", "yaw": 180, "pitch": 0 },
    { "op": "place" },
    { "op": "select", "slot": 9 },
    { "op": "look", "yaw": 90, "pitch": -20 },
    { "op": "spawn", "entity": "spider", "pos": [1.5, -220.5, 6.5] },
    { "op": "wait", "seconds": 0.6 },
    { "op": "screenshot", "name": "cave_spider_a", "hideHud": true },
    { "op": "wait", "seconds": 1.0 },
    { "op": "screenshot", "name": "cave_spider_b", "hideHud": true },
    { "op": "wait", "seconds": 1.5 },
    { "op": "view", "mode": "shoulder" },
    { "op": "screenshot", "name": "cave_spider_c", "hideHud": true },
    { "op": "wait", "seconds": 2.0 },
    { "op": "screenshot", "name": "cave_spider_d", "hideHud": true },
    { "op": "damage", "amount": 999 },
    { "op": "wait", "seconds": 1.0 },

    { "op": "view", "mode": "first" },
    { "op": "spawn", "entity": "spider_broodmother", "pos": [1.5, -220.5, 6.5] },
    { "op": "wait", "seconds": 0.8 },
    { "op": "screenshot", "name": "cave_broodmother_a", "hideHud": true },
    { "op": "wait", "seconds": 1.5 },
    { "op": "screenshot", "name": "cave_broodmother_b", "hideHud": true },
    { "op": "view", "mode": "shoulder" },
    { "op": "wait", "seconds": 2.0 },
    { "op": "screenshot", "name": "cave_broodmother_c", "hideHud": true }
  ]
}
