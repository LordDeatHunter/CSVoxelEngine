    { "op": "wait", "seconds": 0.09 },
    { "op": "screenshot", "name": "return_fading", "hideHud": true },
    { "op": "wait", "seconds": 1 },
    { "op": "give", "block": "item/iron_sword", "count": 1 },
    { "op": "wait", "seconds": 1 },
    { "op": "player", "action": "cut" },
    { "op": "wait", "seconds": 0.36 },
    { "op": "screenshot", "name": "cut_impact", "hideHud": true },
    { "op": "wait", "seconds": 0.08 },
