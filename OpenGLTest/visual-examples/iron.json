{
  // Hematite (iron ore) check: run from OpenGLTest/ with
  //   VOXEL_TIME=147 VOXEL_SCRIPT=visual-examples/iron.json
  // Shots land in visual/iron/.
  //
  // Lays malachite then hematite (the second lands against the first's near face) in a row on the barren frozen plain of
  // snow-sparkle.json and ore-twinkle.json ((-1112, 584), ground 18 under a snow drift, flat for
  // six blocks around; ores.json's spawn spot now sits under a canopy) under a high noon sun, so
  // both sit under identical light: malachite is on the reflective material path and catches the
  // sun, while hematite has no `material` object and must read as plain diffuse beside it. Two
  // framings: head-on from just over the row (both tops side by side), then an oblique look from higher up and to the side.
  //
  // The tool gate (a primitive pickaxe whiffs on hematite, a copper one breaks it) is not filmed
  // here: the `give` op cannot equip a tool instance, so MiningTests covers it instead.
  "steps": [
    { "op": "fly", "on": true },
    { "op": "teleport", "pos": [-1111.5, 50.5, 584.5], "yaw": -90, "pitch": -30 },
    { "op": "wait", "seconds": 16 },
    { "op": "teleport", "pos": [-1111.5, 21.4, 584.5], "yaw": -90, "pitch": -31 },
    { "op": "wait", "seconds": 1 },

    { "op": "give", "block": "malachite_ore", "count": 1 },
    { "op": "look", "yaw": -97, "pitch": -31 },
    { "op": "place" },
    { "op": "give", "block": "hematite_ore", "count": 1 },
    { "op": "look", "yaw": -83, "pitch": -31 },
    { "op": "place" },
    // An empty hotbar slot keeps the first-person held block out of the shots
    { "op": "select", "slot": 9 },
    { "op": "wait", "seconds": 0.5 },

    { "op": "teleport", "pos": [-1111.5, 22.0, 583.0], "yaw": -90, "pitch": -24 },
    { "op": "wait", "seconds": 1 },
    { "op": "screenshot", "name": "row", "hideHud": true },

    { "op": "teleport", "pos": [-1108.0, 23.0, 582.0], "yaw": -125, "pitch": -30 },
    { "op": "wait", "seconds": 1 },
    { "op": "screenshot", "name": "row-oblique", "hideHud": true }
  ]
}
