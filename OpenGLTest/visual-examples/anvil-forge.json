{
  // The anvil forge: run with VOXEL_SCRIPT=visual-examples/anvil-forge.json VOXEL_TIME=147 from OpenGLTest/.
  // Shots land in visual/anvil-forge/. Two anvils in bloomery.json's forest clearing, one with three blooms stacked on
  // it (left) and one with eight (right), then the smithing hammer's recipe list on each: every iron recipe for the
  // eight, only the three that three blooms cover for the other. Picking the first card there picks the axe head (the
  // list closes and the readout counts its hits), and the hammer's hits then forge it out of the whole stack.
  "steps": [
    { "op": "wait", "seconds": 12 },
    { "op": "fly", "on": true },
    { "op": "anvil", "pos": [-42, 10, 58], "metal": "bloom", "count": 3 },
    { "op": "anvil", "pos": [-40, 10, 58], "metal": "bloom", "count": 8 },
    { "op": "teleport", "pos": [-40.5, 12, 61], "yaw": -90, "pitch": -35 },
    { "op": "wait", "seconds": 1.5 },
    { "op": "screenshot", "name": "stacks" },

    { "op": "give", "block": "item/smithing_hammer", "count": 1 },
    { "op": "forge", "action": "open", "pos": [-40, 10, 58] },
    { "op": "wait", "seconds": 0.6 },
    { "op": "screenshot", "name": "recipes-eight" },

    { "op": "forge", "action": "close" },
    { "op": "forge", "action": "open", "pos": [-42, 10, 58] },
    { "op": "wait", "seconds": 0.6 },
    { "op": "screenshot", "name": "recipes-three" },

    { "op": "forge", "action": "pick", "card": 1 },
    { "op": "teleport", "pos": [-41.5, 12, 61], "yaw": -90, "pitch": -40 },
    { "op": "wait", "seconds": 0.8 },
    { "op": "screenshot", "name": "picked" },

    { "op": "hammer", "pos": [-42, 10, 58] },
    { "op": "hammer", "pos": [-42, 10, 58] },
    { "op": "wait", "seconds": 0.3 },
    { "op": "screenshot", "name": "hammering" },
    { "op": "hammer", "pos": [-42, 10, 58] },
    { "op": "hammer", "pos": [-42, 10, 58] },
    { "op": "hammer", "pos": [-42, 10, 58] },
    { "op": "wait", "seconds": 1 },
    { "op": "screenshot", "name": "forged" }
  ]
}
