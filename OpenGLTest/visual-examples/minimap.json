    { "op": "map", "action": "square" },
    { "op": "wait", "seconds": 3 },
    { "op": "screenshot", "name": "surface" },

    { "op": "setblock", "pos": [-48, 10, 56], "block": "alloy_bricks" },
    { "op": "setblock", "pos": [-47, 10, 56], "block": "alloy_bricks" },
    { "op": "setblock", "pos": [-46, 10, 56], "block": "alloy_bricks" },
