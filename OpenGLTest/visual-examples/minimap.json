    { "op": "setblock", "pos": [-48, 10, 59], "block": "alloy_bricks" },
    { "op": "setblock", "pos": [-48, 10, 60], "block": "alloy_bricks" },
    { "op": "setblock", "pos": [-38, 10, 59], "block": "waystone_surface" },
    { "op": "setblock", "pos": [-38, 11, 59], "block": "waystone_surface_upper" },
    { "op": "waystone", "action": "open", "pos": [-38, 10, 59] },
    { "op": "waystone", "action": "close" },
    { "op": "spawn", "entity": "deer", "pos": [-30.5, 53.5] },
    { "op": "spawn", "entity": "boar", "pos": [-52.5, 70.5] },
    { "op": "spawn", "entity": "goblin", "pos": [-43.5, 44.5] },
    { "op": "spawn", "entity": "goblin", "pos": [-40.5, 42.5] },
