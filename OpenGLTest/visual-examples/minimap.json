{
  // The minimap and the [M] map screen: run with VOXEL_SCRIPT=visual-examples/minimap.json VOXEL_TIME=147 from OpenGLTest/.
  // Shots land in visual/minimap/. Films the square minimap over goblins.json's forest clearing, the same spot after a
  // ring of alloy bricks is set down (the edit reaches the map through the remesh), a discovered waystone and a few
  // mobs (neutral deer and boar, hostile goblins) as pins, the round minimap, the map screen following the player, a
  // zoomed and panned view, CENTER, and the cave slice down in the stone. Ends on the square shape, the default.
  "steps": [
    { "op": "wait", "seconds": 12 },
