{
  // Mud brick kiln, a beehive kiln: the anchor model of a 2x2x2 multiblock, so it is authored in 0..32 model
  // units (two cells on every axis, the anchor cell's origin at 0) with the mouth on the NORTH (-Z) face.
  // ContentRegistry pre-rotates the bake to the other three facings (MultiblockShape.Rotate), so this file is
  // the only orientation ever written by hand.
  //
  // Two rules the bake validation enforces: no face may carry a "cullface" (a multiblock's cell neighbors are
  // its own part cells, so a cullface would test the wrong thing), and no face may cover a whole cell face (a
  // rotated quad's corners leave Chunk.CubeFaces order, so every multiblock quad has to shade flat).
  //
  // No face declares "uv": the baker's defaults follow the element's position, so the bricks run on across
  // elements and the sampler's REPEAT tiles them once per cell.
  //
  // The shape, bottom to top: a brick plinth (y 0..3), the brick body (inset 2, y 3..24), two daub dome tiers
  // (inset 5 to y 28, inset 9 to y 30) and a flue collar (x/z 11..21, y 30..32) around a sooty well. The block's
  // multiblock.boxes (data/blocks/mud_brick_kiln.json) trace the same five tiers.
  //
  // The mouth is x 8..24, y 4..19, z 0..20 - cell space [0.5,1.5] x [0.25,1.1875] x [0,1.25], the numbers
  // KilnLayout.Kiln mirrors - under a stepped vault (x 10..22 up to y 21) and behind a fired frame standing one
  // unit proud of the body. Every face omitted below is buried inside another element.
  "textures": {
    "brick": "mud_bricks",
    "hearth": "fired_mud",
    "daub": "kiln_daub",
    "soot": "kiln_soot"
  },
  "elements": [
    // Plinth
    {
      "from": [0, 0, 0],
      "to": [32, 3, 32],
      "faces": {
        "north": { "texture": "#brick" },
        "south": { "texture": "#brick" },
        "west": { "texture": "#brick" },
        "east": { "texture": "#brick" },
        "up": { "texture": "#brick" },
        "down": { "texture": "#brick" }
      }
    },
    // Body, back: the solid rear behind the chamber
    {
      "from": [2, 3, 20],
      "to": [30, 24, 30],
      "faces": {
        "south": { "texture": "#brick" },
        "west": { "texture": "#brick" },
        "east": { "texture": "#brick" },
        "up": { "texture": "#brick" }
      }
    },
    // Body, left pier, west of the mouth; its inner (east) side is fired
    {
      "from": [2, 3, 2],
      "to": [8, 24, 20],
      "faces": {
        "north": { "texture": "#brick" },
        "west": { "texture": "#brick" },
        "east": { "texture": "#hearth" },
        "up": { "texture": "#brick" }
      }
    },
    // Body, right pier, east of the mouth; its inner (west) side is fired
    {
      "from": [24, 3, 2],
      "to": [30, 24, 20],
      "faces": {
        "north": { "texture": "#brick" },
        "east": { "texture": "#brick" },
        "west": { "texture": "#hearth" },
        "up": { "texture": "#brick" }
      }
    },
    // Body, lintel over the vault; its underside is fired
    {
      "from": [8, 21, 2],
      "to": [24, 24, 20],
      "faces": {
        "north": { "texture": "#brick" },
        "up": { "texture": "#brick" },
        "down": { "texture": "#hearth" }
      }
    },
    // Vault steps: the two fired corbels that narrow the mouth above y 19
    {
      "from": [8, 19, 2],
      "to": [10, 21, 20],
      "faces": {
        "north": { "texture": "#hearth" },
        "east": { "texture": "#hearth" },
        "down": { "texture": "#hearth" }
