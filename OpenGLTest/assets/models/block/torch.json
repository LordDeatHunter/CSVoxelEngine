{
    // A floor torch: one thin post standing on the cell floor, its faces cropped out of the
    // torch tile (hand-drawn: a 4x20 px body at the top left, the 4x4 top cap and 4x4 bottom to its right).
    // Unshaded like Minecraft's, so the flame never darkens with the face it is on.
    "textures": {
        "particle": "#torch",
        "torch": "torch"
    },
    "elements": [
        {
            "from": [7, 0, 7],
            "to": [9, 10, 9],
            "shade": false,
            "faces": {
                "north": { "uv": [14, 0, 16, 10], "texture": "#torch" },
                "south": { "uv": [14, 0, 16, 10], "texture": "#torch" },
                "west": { "uv": [14, 0, 16, 10], "texture": "#torch" },
                "east": { "uv": [14, 0, 16, 10], "texture": "#torch" },
                "up": { "uv": [2, 14, 4, 16], "texture": "#torch" },
                "down": { "uv": [2, 12, 4, 14], "texture": "#torch", "cullface": "down" }
            }
        }
    ]
}
