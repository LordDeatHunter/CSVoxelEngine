{
    // A plain glass pane: one 2 px slab through the middle of the cell, full width along X and
    // full height. Its big faces sit inside the cell and always draw; its thin ends, top and
    // bottom cull against a neighbour (the block's cullSelf fuses a row or a stack of panes).
    // UVs are left to the defaults, which crop the glass tile to each face.
    "textures": {
        "particle": "#pane",
        "pane": "glass"
    },
    "elements": [
        {
            "from": [0, 0, 7],
            "to": [16, 16, 9],
            "faces": {
                "north": { "texture": "#pane" },
                "south": { "texture": "#pane" },
                "west": { "texture": "#pane", "cullface": "west" },
                "east": { "texture": "#pane", "cullface": "east" },
                "up": { "texture": "#pane", "cullface": "up" },
                "down": { "texture": "#pane", "cullface": "down" }
            }
        }
    ]
}
