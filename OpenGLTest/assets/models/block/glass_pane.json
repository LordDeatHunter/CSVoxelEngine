{
    // A glass pane as the icon, the held pane and the drop show it: one 2 px slab through the
    // middle of the cell, full width along X and full height. In the world the pane renderer
    // draws the post and arms instead (PaneShape) and only takes the tile from here. UVs are left
    // to the defaults, which crop the glass tile to each face.
    "textures": {
        "particle": "#pane",
        "pane": "glass"
    },
    "elements": [
        {
            "from": [0, 0, 7],
            "to": [16, 16, 9],
            "faces": {
                "north": { "texture": "#pane" },
                "south": { "texture": "#pane" },
                "west": { "texture": "#pane", "cullface": "west" },
                "east": { "texture": "#pane", "cullface": "east" },
                "up": { "texture": "#pane", "cullface": "up" },
                "down": { "texture": "#pane", "cullface": "down" }
            }
        }
    ]
}
