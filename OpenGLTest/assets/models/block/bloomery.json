{
  // Bloomery, a shaft furnace: the anchor model of a 2x2x2 multiblock, so it is authored in 0..32 model units
  // (two cells on every axis, the anchor cell's origin at 0) with the tapping arch on the NORTH (-Z) face.
  // ContentRegistry pre-rotates the bake to the other three facings (MultiblockShape.Rotate), so this file is
  // the only orientation ever written by hand.
  //
  // Two rules the bake validation enforces: no face may carry a "cullface" (a multiblock's cell neighbors are
  // its own part cells, so a cullface would test the wrong thing), and no face may cover a whole cell face (a
  // rotated quad's corners leave Chunk.CubeFaces order, so every multiblock quad has to shade flat).
  //
  // No face declares "uv" but the tuyere ends: the baker's defaults follow the element's position, so the
  // bricks run on across elements, and the iron hoops (bloomery_band repeats every 2 units) sit on even heights.
  //
  // The shape, bottom to top: a plinth (y 0..4), the hearth tier (inset 3, y 4..14), an iron hoop (inset 2,
  // y 14..16), the middle tier (inset 5, y 16..24), a second hoop (inset 4, y 24..26) and the top tier (inset 7,
  // y 26..32) around the open throat, a well x/z 11..21 whose sooty floor is at y 26.25. The block's
  // multiblock.boxes (data/blocks/bloomery.json) trace the tiers and the two nozzles.
  //
  // The tapping arch is x 10..22, y 5..12, z 3..15 and the throat well x/z 11..21 from y 26.25 up: the numbers
  // BloomeryLayout mirrors. The two tuyeres (blocks/bloomery.json "tuyeres", where a bellows works it) are clay
  // nozzles standing out of the hearth tier to the side faces of the volume, at the back lower cell of each side
  // wall (y 4..12, z 20..28), their ends the hole tile (a full tile, so "uv" is given).
  // Every face omitted below is buried inside another element.
  "textures": {
    "brick": "bloomery_bricks",
    "hearth": "fired_mud",
    "band": "bloomery_band",
    "soot": "kiln_soot",
    "tuyere": "bloomery_tuyere"
  },
  "elements": [
    // Plinth
    {
      "from": [0, 0, 0],
      "to": [32, 4, 32],
      "faces": {
        "north": { "texture": "#brick" },
        "south": { "texture": "#brick" },
        "west": { "texture": "#brick" },
        "east": { "texture": "#brick" },
        "up": { "texture": "#brick" },
        "down": { "texture": "#brick" }
      }
    },
    // Hearth tier, back: the solid rear behind the arch
    {
      "from": [3, 4, 15],
      "to": [29, 14, 29],
      "faces": {
        "south": { "texture": "#brick" },
        "west": { "texture": "#brick" },
        "east": { "texture": "#brick" }
      }
    },
    // Hearth tier, left pier; its inner (east) side is fired
    {
      "from": [3, 4, 3],
      "to": [10, 14, 15],
      "faces": {
        "north": { "texture": "#brick" },
        "west": { "texture": "#brick" },
        "east": { "texture": "#hearth" }
      }
    },
    // Hearth tier, right pier; its inner (west) side is fired
    {
      "from": [22, 4, 3],
      "to": [29, 14, 15],
      "faces": {
        "north": { "texture": "#brick" },
        "east": { "texture": "#brick" },
        "west": { "texture": "#hearth" }
      }
    },
    // Hearth tier, lintel over the arch; its underside is fired
    {
      "from": [10, 12, 3],
      "to": [22, 14, 15],
      "faces": {
        "north": { "texture": "#hearth" },
        "down": { "texture": "#hearth" }
      }
    },
    // Arch back wall: the north-facing quad seen through the arch
    {
      "from": [10, 5, 15],
      "to": [22, 12, 16],
      "faces": {
        "north": { "texture": "#hearth" }
      }
    },
    // Hearth floor: what the fuel and the finished blooms lie on
    {
      "from": [10, 4, 3],
      "to": [22, 5, 15],
      "faces": {
        "north": { "texture": "#hearth" },
        "up": { "texture": "#hearth" }
      }
    },
    // West tuyere nozzle, against the bellows cell [-1, 0, 1]
    {
      "from": [0, 4, 20],
      "to": [3, 12, 28],
      "faces": {
        "west": { "uv": [0, 0, 16, 16], "texture": "#tuyere" },
        "north": { "texture": "#hearth" },
        "south": { "texture": "#hearth" },
        "up": { "texture": "#hearth" }
      }
    },
    // East tuyere nozzle, against the bellows cell [2, 0, 1]
    {
      "from": [29, 4, 20],
      "to": [32, 12, 28],
      "faces": {
        "east": { "uv": [0, 0, 16, 16], "texture": "#tuyere" },
        "north": { "texture": "#hearth" },
        "south": { "texture": "#hearth" },
        "up": { "texture": "#hearth" }
      }
    },
    // Lower hoop
    {
      "from": [2, 14, 2],
      "to": [30, 16, 30],
      "faces": {
        "north": { "texture": "#band" },
        "south": { "texture": "#band" },
        "west": { "texture": "#band" },
        "east": { "texture": "#band" },
        "up": { "texture": "#band" },
        "down": { "texture": "#band" }
      }
    },
    // Middle tier
    {
      "from": [5, 16, 5],
      "to": [27, 24, 27],
      "faces": {
        "north": { "texture": "#brick" },
        "south": { "texture": "#brick" },
        "west": { "texture": "#brick" },
        "east": { "texture": "#brick" }
      }
    },
    // Upper hoop; its top is the ledge around the top tier and lies under the throat's floor
    {
      "from": [4, 24, 4],
      "to": [28, 26, 28],
      "faces": {
        "north": { "texture": "#band" },
        "south": { "texture": "#band" },
        "west": { "texture": "#band" },
        "east": { "texture": "#band" },
        "up": { "texture": "#band" },
        "down": { "texture": "#band" }
      }
    },
    // Top tier: four walls around the throat, their inner sides fired
    {
      "from": [7, 26, 7],
      "to": [25, 32, 11],
      "faces": {
        "north": { "texture": "#brick" },
        "south": { "texture": "#hearth" },
        "west": { "texture": "#brick" },
        "east": { "texture": "#brick" },
        "up": { "texture": "#hearth" }
      }
    },
    {
      "from": [7, 26, 21],
      "to": [25, 32, 25],
      "faces": {
        "south": { "texture": "#brick" },
        "north": { "texture": "#hearth" },
        "west": { "texture": "#brick" },
        "east": { "texture": "#brick" },
        "up": { "texture": "#hearth" }
      }
    },
    {
      "from": [7, 26, 11],
      "to": [11, 32, 21],
      "faces": {
        "west": { "texture": "#brick" },
        "east": { "texture": "#hearth" },
        "up": { "texture": "#hearth" }
      }
    },
    {
      "from": [21, 26, 11],
      "to": [25, 32, 21],
      "faces": {
        "east": { "texture": "#brick" },
        "west": { "texture": "#hearth" },
        "up": { "texture": "#hearth" }
      }
    },
    // Throat floor, a hair over the upper hoop's top so the two never share a plane: what the ore charge lies on
    {
      "from": [11, 26, 11],
      "to": [21, 26.25, 21],
      "faces": {
        "up": { "texture": "#soot" }
      }
    }
  ]
}
