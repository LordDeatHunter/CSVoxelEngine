{
  // Bloomery: the anchor model (the mud brick kiln's shape in fired bloomery brick) of a 2x2x2 multiblock, so it is authored in 0..32 model
  // units (two cells on every axis, the anchor cell's origin at 0) with the opening on the
  // NORTH (-Z) face. ContentRegistry pre-rotates the bake to the other three facings
  // (MultiblockShape.Rotate), so this file is the only orientation ever written by hand.
  //
  // Two rules the bake validation enforces: no face may carry a "cullface" (a multiblock's
  // cell neighbors are its own part cells, so a cullface would test the wrong thing), and no
  // face may cover a whole cell face (a rotated quad's corners leave Chunk.CubeFaces order, so
  // every multiblock quad has to shade flat).
  //
  // No face declares "uv": the baker's defaults span two tile units across a two-cell box and
  // the sampler's REPEAT tiles the bricks once per cell.
  //
  // The opening is x 8..24, y 2..18, z 0..12 - cell space [0.5,1.5] x [0.125,1.125] x [0,0.75],
  // the numbers KilnRenderer mirrors. Every face omitted below is buried inside another element.
  //
  // The two tuyeres (the blocks/bloomery.json "tuyeres", where a bellows works it) are holes sunk one unit into the
  // back lower cell of each side wall (y 3..11, z 20..28): the back body is a core one unit in from each side, skinned by
  // four brick strips per side that leave the hole open, its walls fired and its floor the hole tile (full tile, so
  // "uv" is given). A model may not leave its volume, so the holes go in rather than standing out.
  "textures": {
    "brick": "bloomery_bricks",
    "hearth": "fired_mud",
    "tuyere": "bloomery_tuyere"
  },
  "elements": [
    // Back body core: the solid rear half, one unit in from each side wall. Its north side is hidden by the two piers,
    // the lintel, the hearth floor and the hearth's back wall; its sides by the skin strips and the tuyere holes.
    {
      "from": [1, 0, 12],
      "to": [31, 32, 32],
      "faces": {
        "south": { "texture": "#brick" },
        "up": { "texture": "#brick" },
        "down": { "texture": "#brick" }
      }
    },
    // West skin, below the tuyere
    {
      "from": [0, 0, 12],
      "to": [1, 3, 32],
      "faces": {
        "west": { "texture": "#brick" },
        "south": { "texture": "#brick" },
        "down": { "texture": "#brick" },
        "up": { "texture": "#hearth" }
      }
    },
    // West skin, above the tuyere
    {
      "from": [0, 11, 12],
      "to": [1, 32, 32],
      "faces": {
        "west": { "texture": "#brick" },
        "south": { "texture": "#brick" },
        "up": { "texture": "#brick" },
        "down": { "texture": "#hearth" }
      }
    },
    // West skin, in front of the tuyere
    {
      "from": [0, 3, 12],
      "to": [1, 11, 20],
      "faces": {
        "west": { "texture": "#brick" },
        "south": { "texture": "#hearth" }
      }
    },
    // West skin, behind the tuyere
    {
      "from": [0, 3, 28],
      "to": [1, 11, 32],
      "faces": {
        "west": { "texture": "#brick" },
        "south": { "texture": "#brick" },
        "north": { "texture": "#hearth" }
      }
    },
    // West tuyere: the hole's floor, against the bellows cell [-1, 0, 1]
    {
      "from": [1, 3, 20],
      "to": [1, 11, 28],
      "faces": {
        "west": { "uv": [0, 0, 16, 16], "texture": "#tuyere" }
      }
    },
    // East skin, below the tuyere
    {
      "from": [31, 0, 12],
      "to": [32, 3, 32],
      "faces": {
        "east": { "texture": "#brick" },
        "south": { "texture": "#brick" },
        "down": { "texture": "#brick" },
        "up": { "texture": "#hearth" }
      }
    },
    // East skin, above the tuyere
    {
      "from": [31, 11, 12],
      "to": [32, 32, 32],
      "faces": {
        "east": { "texture": "#brick" },
        "south": { "texture": "#brick" },
        "up": { "texture": "#brick" },
        "down": { "texture": "#hearth" }
      }
    },
    // East skin, in front of the tuyere
    {
      "from": [31, 3, 12],
      "to": [32, 11, 20],
      "faces": {
        "east": { "texture": "#brick" },
        "south": { "texture": "#hearth" }
      }
    },
    // East skin, behind the tuyere
    {
      "from": [31, 3, 28],
      "to": [32, 11, 32],
      "faces": {
        "east": { "texture": "#brick" },
        "south": { "texture": "#brick" },
        "north": { "texture": "#hearth" }
      }
    },
    // East tuyere: the hole's floor, against the bellows cell [2, 0, 1]
    {
      "from": [31, 3, 20],
      "to": [31, 11, 28],
      "faces": {
        "east": { "uv": [0, 0, 16, 16], "texture": "#tuyere" }
      }
    },
    // Hearth back wall: the single north-facing quad seen through the opening, fired by the
    // fire in front of it.
    {
      "from": [8, 2, 12],
      "to": [24, 18, 13],
      "faces": {
        "north": { "texture": "#hearth" }
      }
    },
    // Left pier, west of the opening; its inner (east) side is fired.
    {
      "from": [0, 0, 0],
      "to": [8, 32, 12],
      "faces": {
        "north": { "texture": "#brick" },
        "west": { "texture": "#brick" },
        "east": { "texture": "#hearth" },
        "up": { "texture": "#brick" },
        "down": { "texture": "#brick" }
      }
    },
    // Right pier, east of the opening; its inner (west) side is fired.
    {
      "from": [24, 0, 0],
      "to": [32, 32, 12],
      "faces": {
        "north": { "texture": "#brick" },
        "east": { "texture": "#brick" },
        "west": { "texture": "#hearth" },
        "up": { "texture": "#brick" },
        "down": { "texture": "#brick" }
      }
    },
    // Lintel over the opening; its underside is fired.
    {
      "from": [8, 18, 0],
      "to": [24, 32, 12],
      "faces": {
        "north": { "texture": "#brick" },
        "up": { "texture": "#brick" },
        "down": { "texture": "#hearth" }
      }
    },
    // Hearth floor: the ledge the fire, the fuel and (later) the crucible sit on.
    {
      "from": [8, 0, 0],
      "to": [24, 2, 12],
      "faces": {
        "north": { "texture": "#brick" },
        "up": { "texture": "#hearth" },
        "down": { "texture": "#brick" }
      }
    }
  ]
}
