  // fills the mold.
  //
  // "model" is what the station renderer draws: the sprite below stays the inventory icon, but
  // KilnManager's render pass shows the baked bowl sitting in the hearth.
  //
  // TODO: placeholder art - crucible.png is a byte copy of bucket.png until the real sprite lands.
  "name": "Crucible",
  "texture": "assets/textures/items/crucible.png",
  "model": "block/crucible",
  "crucible": { "capacityMl": 400 }
}
