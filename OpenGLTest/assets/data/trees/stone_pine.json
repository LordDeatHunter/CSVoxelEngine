{
  "wood": "block/stone_pine_log",
  "leaves": "block/stone_pine_leaves",
  "growth": {
    "logic": "umbrella",
    "signalEnergy": 22,
    "upProbability": 2,
    "lowestBranchHeight": 8,
    "maturitySteps": [70, 95]
  },
  // Shape tuned against 48 flat-ground mature trees (the 8 test samples plus 40 more): a bare trunk
  // of 11 cells, 65-69 % of the tree's 16-17-block height, splitting into 4 limbs (one per side)
  // that climb out through the bare zone as staircases, 4-8 bare wood cells each before the first
  // leaf, then flat pads only at the outer limb ends; the tree is 19-26 blocks across (1.1-1.6x,
  // median 1.35x its height), 12-26 live tips, 283-508 leaves. pipeExponent 1.5 with the 3.0 base
  // girth grows the root to 16 px on every mature tree (5-7 / 7-8 / 8-10 / 10-16 px at
  // 15/25/50/75 %), so the full pad radius (fullRadiusPx 14) waits for a mature trunk; the shorter
  // maturitySteps keep the outer crown from closing into one mat over the limbs.
  "thickness": {
    "tipPx": 1,
    "pipeExponent": 1.5,
    "maxPx": 24,
    "girthProfile": [[0, 3.0], [0.6, 1.6], [1, 1.0]],
    "trunkShape": "circle",
    "rim": "block"
  },
  "leafCluster": { "shape": "pad", "radius": 3, "hydration": 6, "tipMaxPx": 3, "minRadius": 1, "fullRadiusPx": 14 },
  "features": [ { "type": "roots", "depth": 4 } ],
  // lod tuned against 48 flat-ground mature trees grown alone (not in a worldgen batch): crown
  // apex above base p20/p50/p80 15/16/16, leaf radius from the trunk column p50/p80 11/12,
  // footprint-equivalent radius (sqrt(leaf columns / pi)) median 8.2
  "lod": { "crownHeight": [15, 16], "crownRadius": 8, "profile": "dome" },
  // A sparse savanna tree: its umbrella crown stands in for an acacia. Its reach (signalEnergy 22
  // plus the pad radius 3) equals the palm's and its lod crownRadius (8) is under the palm's (10),
  // so planting it raises neither TreeGenerator.ReachChunkRadius nor the proxy canopy reach.
  // openness 0: the forest-openness thinning never empties the savanna.
  "worldgen": {
    "biomes": ["savanna"],
    "density": 0.003,
    "spacing": 8,
    "maxSlope": 3,
    "minSoil": 2,
    "minGround": 1,
    "maxGround": 90,
    "openness": 0
  }
}
