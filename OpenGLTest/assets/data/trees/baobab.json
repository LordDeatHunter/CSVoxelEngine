{
  "wood": "block/baobab_log",
  "leaves": "block/baobab_leaves",
  "growth": {
    "logic": "baobab",
    "signalEnergy": 16,
    "upProbability": 3,
    "lowestBranchHeight": 5,
    "maturitySteps": [90, 130]
  },
  // A wide, pixel-beveled trunk: the strong base girth swells the trunk chain past 48 px, where
  // it becomes a core plus a ring of shells (TreeRasterizer), and the rim rounds the ring off.
  // The profile drops steeply above the trunk so the crown's limbs stay near 16 px.
  // Tuned against 8 flat-ground seeds: root 79-80 px (block radius 2 on 7 of 8, 1 otherwise),
  // nodes 93-109, wood incl. shells and fins 140-201, off-trunk limbs 7-19 px, 8-16 fins.
  "thickness": {
    "tipPx": 2,
    "pipeExponent": 1.6,
    "maxPx": 80,
    "girthProfile": [[0, 7.0], [0.3, 4.5], [0.4, 1.3], [1, 1.0]],
    "trunkShape": "circle",
    "rim": "pixel"
  },
  // the root passes one block within its first pulses, so the crown scaling only shrinks a
  // seedling's crown; support caps at one block, and wide-trunk support is out of scope
  "leafCluster": { "shape": "blob", "radius": 2, "hydration": 3, "tipMaxPx": 4, "minRadius": 1, "fullRadiusPx": 16 },
  "features": [ { "type": "buttress" } ],
  // lod tuned against 48 flat-ground mature trees (no worldgen block, so no batch crowns): crown
  // apex above base p20/p50/p80 14/16/17, leaf radius from the trunk column p50/p80 5/5,
  // footprint-equivalent radius (sqrt(leaf columns / pi)) median 4.4
  "lod": { "crownHeight": [15, 17], "crownRadius": 4, "profile": "dome" }
  // no worldgen block: grown in-world only (TreeGrowthWriter, the `grow` scenario op)
}
