{
  // Ingot mold: a mud slab pressed from three mudballs (recipes/mold_ingot.json) with an
  // ingot-shaped pocket carved into its top, and pressed back apart into those three mudballs
  // (recipes/mudball_from_mold_ingot.json). Baked on a lit campfire it hardens into
  // fired_mold_ingot (recipes/cook/mold_ingot.json), which is what molten metal is poured into
  // (recipes/cast/copper_ingot.json).
  // The model is generated by tools/generate-mold-models.ps1 from the item sprite's alpha
  // silhouette and is never hand-edited; the hitbox height below must equal that script's
  // $SlabHeight / 16 (MoldTests pins the tie).
  "name": "Ingot Mold",
  "model": "block/mold_ingot",
  "hardness": 2,
  "sfx": "hit_default",
  // A quarter-height slab must not darken the floor around it the way a full cube would.
  "castsAO": false,
  "collidesByHitbox": true,
  "hitbox": { "min": [0, 0, 0], "max": [1, 0.25, 1] }
}
