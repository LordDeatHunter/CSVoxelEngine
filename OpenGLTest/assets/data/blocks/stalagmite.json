{
  // A stone point rising from a cave floor (CaveFormationGenerator), standing on its floor like
  // any needsSupport block: mine the floor and it pops. Walked through; its hitbox is the model's three segments (outline and mining pop follow them).
  "name": "Stalagmite",
  "model": { "parent": "block/stalagmite", "textures": { "stone": "stone" } },
  "hardness": 4,
  "solid": false,
  "occludes": false,
  "castsAO": false,
  "light": { "passes": true },
  "hasItem": false,
  "needsSupport": true,
  // Rock, not vegetation: a flow washes an ordinary fragile block away, never this one
  "flowResistant": true,
  "blocksSight": false,
  "loot": "cave_stone",
  "hitbox": [
    { "min": [0.3125, 0, 0.3125], "max": [0.6875, 0.375, 0.6875] },
    { "min": [0.375, 0.375, 0.375], "max": [0.625, 0.6875, 0.625] },
    { "min": [0.4375, 0.6875, 0.4375], "max": [0.5625, 1, 0.5625] }
  ]
}
