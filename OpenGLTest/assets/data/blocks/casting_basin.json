{
  // Fired casting basin: a bowl molten material is poured into to cast a block
  // (recipes/cast/glass.json). Fired from casting_basin_raw; a fired basin never uncrafts.
  // Its pocket is CastingRenderer.Basin; its hitbox boxes are the model's elements, so the outline follows the bowl.
  "name": "Casting Basin",
  "model": "block/casting_basin",
  "hardness": 2,
  "sfx": "hit_rock",
  "castsAO": false,
  "collidesByHitbox": true,
  "hitbox": [
    { "min": [0.125, 0, 0.125], "max": [0.875, 0.125, 0.875] },
    { "min": [0, 0, 0], "max": [1, 0.5, 0.125] },
    { "min": [0, 0, 0.875], "max": [1, 0.5, 1] },
    { "min": [0, 0, 0.125], "max": [0.125, 0.5, 0.875] },
    { "min": [0.875, 0, 0.125], "max": [1, 0.5, 0.875] }
  ]
}
