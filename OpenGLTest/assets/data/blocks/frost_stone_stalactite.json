{
  // A stone point hanging from a cave ceiling (CaveFormationGenerator): needsSupport with
  // support "above", so it hangs from the block over it and pops when that is mined.
  "name": "Frost Stone Stalactite",
  "model": { "parent": "block/stalactite", "textures": { "stone": "frost_stone" } },
  "hardness": 4,
  "solid": false,
  "occludes": false,
  "castsAO": false,
  "light": { "passes": true },
  "hasItem": false,
  "needsSupport": true,
  // Rock, not vegetation: a flow washes an ordinary fragile block away, never this one
  "flowResistant": true,
  "support": "above",
  "blocksSight": false,
  "loot": "cave_frost_stone",
  "hitbox": { "min": [0.3, 0, 0.3], "max": [0.7, 1, 0.7] }
}
