{
  // Raw casting basin: a mud bowl pressed from four mudballs (recipes/casting_basin_raw.json),
  // pressed back apart by recipes/mudball_from_casting_basin_raw.json. Baked on a lit campfire
  // it hardens into casting_basin (recipes/cook/casting_basin_raw.json). Not a cast mold itself.
  // Its hitbox boxes are the model's elements, so the outline follows the bowl.
  "name": "Raw Casting Basin",
  "model": "block/casting_basin_raw",
  "hardness": 2,
  "sfx": "hit_default",
  "castsAO": false,
  "collidesByHitbox": true,
  "hitbox": [
    { "min": [0.125, 0, 0.125], "max": [0.875, 0.125, 0.875] },
    { "min": [0, 0, 0], "max": [1, 0.5, 0.125] },
    { "min": [0, 0, 0.875], "max": [1, 0.5, 1] },
    { "min": [0, 0, 0.125], "max": [0.125, 0.5, 0.875] },
    { "min": [0.875, 0, 0.125], "max": [1, 0.5, 0.875] }
  ]
}
