{
  "name": "Torch",
  "model": "block/torch",
  "hardness": 0,
  "solid": false,
  "castsAO": false,
  // The tile is a stick on transparent texels: alpha-tested, and it gets the coverage-keeping mips
  "cutout": true,
  // The default warm block-light color, so the torch costs no palette slot
  "light": { "emission": 14 },
  // The flame flickers half a pixel above the head of the stick (block/torch tops out at y 10)
  "flame": [8, 10.5, 8],
  // Pops (dropping itself) when the block it stands on goes, and a flow washes it away
  "needsSupport": true,
  // Placed against a block's side it becomes the wall torch, leaning out from that wall
  "wallBlock": "block/wall_torch",
  "hitbox": { "min": [0.375, 0, 0.375], "max": [0.625, 0.625, 0.625] }
}
