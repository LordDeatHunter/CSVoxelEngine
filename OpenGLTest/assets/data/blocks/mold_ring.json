{
  // Ring mold: a mud slab pressed from three mudballs (recipes/mold_ring.json) with a
  // ring-shaped pocket carved into its top, and pressed back apart into those three mudballs
  // (recipes/mudball_from_mold_ring.json). Baked on a lit campfire it hardens into
  // fired_mold_ring (recipes/cook/mold_ring.json), which is what molten metal is poured into
  // (recipes/cast/*_ring*.json).
  // The model is generated by tools/generate-mold-models.ps1 from the item sprite's alpha
  // silhouette and is never hand-edited; the hitbox height below must equal that script's
  // $SlabHeight / 16 (MoldTests pins the tie).
  "name": "Ring Mold",
  "model": "block/mold_ring",
  "hardness": 2,
  "sfx": "hit_default",
  // A quarter-height slab must not darken the floor around it the way a full cube would.
  "castsAO": false,
  "collidesByHitbox": true,
  "hitbox": { "min": [0, 0, 0], "max": [1, 0.25, 1] }
}
