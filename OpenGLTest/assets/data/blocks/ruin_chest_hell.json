{
  // Charred Chest: the chest of a hell outpost. A chest block entity (ChestManager): right-click opens it, breaking it spills what it holds.
  // Worldgen-made (and creative-placeable): it holds nothing until first opened or broken, then rolls the "ruin_hell" loot table from the hash of its cell
  // and the world seed. It has an item so the creative catalog can place it, but breaking it drops nothing but its contents.
  "name": "Charred Chest",
  "model": { "parent": "block/chest", "textures": { "front": "chest_ruin_hell_front", "back": "chest_ruin_hell_back", "left": "chest_ruin_hell_left", "right": "chest_ruin_hell_right", "bottom": "chest_ruin_hell_bottom", "top": "chest_ruin_hell_top" } },
  "facing": "horizontal",
  "facingFromLook": true,
  "facesViewer": true,
  "hardness": 6,
  "sfx": "hit_rock",
  "castsAO": false,
  "collidesByHitbox": true,
  "hitbox": { "min": [0.0625, 0, 0.0625], "max": [0.9375, 0.875, 0.9375] },
  "loot": "none",
  "chest": { "slots": 18, "skin": "chest_ruin_hell", "loot": "ruin_hell" }
}
