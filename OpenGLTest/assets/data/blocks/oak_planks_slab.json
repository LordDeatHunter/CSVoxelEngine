{
  // A bottom half block of oak planks: six from three planks (recipes/oak_planks_slab.json).
  // The body collides with the half-height hitbox, so it is stepped onto and stood on like a
  // mold; there is no top-half placement yet.
  "name": "Oak Plank Slab",
  "model": {
    "parent": "block/slab",
    "textures": { "bottom": "oak_planks", "top": "oak_planks", "side": "oak_planks" }
  },
  "hardness": 6,
  "sfx": "hit_wood",
  // A half block must not darken the floor around it the way a full cube would
  "castsAO": false,
  "collidesByHitbox": true,
  "hitbox": { "min": [0, 0, 0], "max": [1, 0.5, 1] }
}
