{
  // Fired ingot mold: mold_ingot baked on a lit campfire (recipes/cook/mold_ingot.json).
  // Firing is one-way — a fired mold has no uncraft recipe, so the three mudballs are spent.
  // The model is generated by tools/generate-mold-models.ps1 (geometry identical to the raw
  // mold, wearing the fired_mud tile) and is never hand-edited; the hitbox height below must
  // equal that script's $SlabHeight / 16 (MoldTests pins the tie).
  "name": "Fired Ingot Mold",
  "model": "block/fired_mold_ingot",
  "hardness": 2,
  "sfx": "hit_rock",
  // A quarter-height slab must not darken the floor around it the way a full cube would.
  "castsAO": false,
  "collidesByHitbox": true,
  "hitbox": { "min": [0, 0, 0], "max": [1, 0.25, 1] }
}
