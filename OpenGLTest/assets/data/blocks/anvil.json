{
  // A stone anvil (six cobblestone, recipes/anvil.json): the forge. Blooms (or vulcanite) stacked on it are worked into
  // parts and armor: a smithing hammer's right-click picks the recipe, its hits forge it (recipes/forge/, AnvilManager).
  // Base, waist and a top with a horn (models/block/anvil.json, tile hand-authored). The body collides with its hitbox
  // boxes.
  "name": "Anvil",
  "model": "block/anvil",
  "hardness": 5,
  "sfx": "hit_rock",
  "requiresTool": true,
  "tools": { "pickaxe": 1 },
  // The hits each forge takes are the recipe's own, at the hammer's own pace.
  "anvil": true,
  "castsAO": false,
  "collidesByHitbox": true,
  "hitbox": [
    { "min": [0.125, 0, 0.125], "max": [0.875, 0.1875, 0.875] },
    { "min": [0.3125, 0.1875, 0.25], "max": [0.6875, 0.5625, 0.75] },
    { "min": [0.0625, 0.5625, 0.1875], "max": [0.9375, 0.9375, 0.8125] },
    { "min": [0, 0.5625, 0.3125], "max": [0.0625, 0.8125, 0.6875] }
  ]
}
