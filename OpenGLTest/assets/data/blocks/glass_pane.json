{
  "name": "Glass Pane",
  // The model is the plain slab the icon, the held pane and the drop show; in the world the
  // pane renderer draws a post plus an arm toward every neighbouring pane or solid full cube
  // (PaneShape), and the raycast, the outline and the body collide with exactly those arms
  "model": "block/glass_pane",
  "renderer": "pane",
  "hardness": 1,
  // Glass's flags: drawn blended in the translucent pass, fused with its own kind, never
  // hiding a neighbour, darkening nothing and letting light through
  "translucent": true,
  "cullSelf": true,
  "occludes": false,
  "castsAO": false,
  "light": { "passes": true }
}
