{
  // Miner's Chest: the chest of an abandoned mining base. A chest block entity (ChestManager): right-click opens it, breaking it spills what it holds.
  // Worldgen-only: the underground ruin stamp writes the cave biome of the chest's own cell into state bits 2-7 as its tier, and the
  // chest holds nothing until first opened or broken, then rolls the loot table "tiers" names for that tier from the hash of its cell
  // and the world seed. The tiers follow the CaveBiome ordinals: Plain (the plain "ruin_underground"), FrozenEcho, DesertEcho,
  // Crystal, Fungal, MagmaDeep; each flavoured table nests "ruin_underground" and adds its cave's own pool. It is picked as a wooden
  // chest and drops nothing but its contents.
  "name": "Miner's Chest",
  "model": { "parent": "block/chest", "textures": { "front": "chest_ruin_underground_front", "side": "chest_ruin_underground_side", "top": "chest_ruin_underground_top" } },
  "facing": "horizontal",
  "facingFromLook": true,
  "hardness": 4,
  "sfx": "hit_wood",
  "castsAO": false,
  "collidesByHitbox": true,
  "hitbox": { "min": [0.0625, 0, 0.0625], "max": [0.9375, 0.875, 0.9375] },
  "hasItem": false,
  "pickAs": "wooden_chest",
  "loot": "none",
  "chest": {
    "slots": 18,
    "skin": "chest_ruin_underground",
    "tiers": [
      "ruin_underground", "ruin_underground_frozen", "ruin_underground_desert",
      "ruin_underground_crystal", "ruin_underground_fungal", "ruin_underground_magma"
    ]
  }
}
