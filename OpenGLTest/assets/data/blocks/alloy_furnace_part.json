  "hasItem": false,
  "hardness": 5,
  "requiresTool": true,
  "tools": { "pickaxe": 1 },
  "sfx": "hit_rock",
  "loot": "alloy_furnace",
  "occludes": true,
  "castsAO": true,
  "light": { "passes": true }
}
