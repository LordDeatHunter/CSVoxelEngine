{
  // Cobblestone stairs: four from six cobblestone (recipes/cobblestone_stairs.json). The state
  // byte holds the facing, taken from the placing player's look (facingFromLook), so looking north
  // places them climbing north; the model and the two boxes are authored facing north and turned
  // to the other three. The body collides with the two boxes, so the stairs are walked up.
  "name": "Cobblestone Stairs",
  "model": {
    "parent": "block/stairs",
    "textures": { "bottom": "cobblestone", "top": "cobblestone", "side": "cobblestone" }
  },
  "facing": "horizontal",
  "facingFromLook": true,
  "sfx": "hit_rock",
  "requiresTool": true,
  "tools": { "pickaxe": 1 },
  // A partial block must not darken the floor around it the way a full cube would
  "castsAO": false,
  "collidesByHitbox": true,
  "hitbox": [
    { "min": [0, 0, 0], "max": [1, 0.5, 1] },
    { "min": [0, 0.5, 0], "max": [1, 1, 0.5] }
  ]
}
