{
  // A bloomery's bellows (recipes/bellows.json): set it against one of a bloomery's tuyeres (the holes low in its
  // side walls, the bloomery object's "tuyeres") and land on it to blow the fire hotter; the farther the body fell, the
  // more heat (BloomeryRules.LandingHeat). A player or any walking mob works it, an item drop never does. A plain cube
  // for now: the tiles are placeholders (USER_TODO.md) until it gets a real model.
  //
  // It gives under a weight: "sink" lets a player's body settle slowly into its top half (SinkLayer), the bag is
  // drawn squashed down to the feet standing in it and swells back to a full block once they leave (BellowsSquash).
  // A squashed bellows no longer fills its cell, so it must not hide its neighbors' faces.
  "name": "Bellows",
  "model": {
    "parent": "block/cube_bottom_top",
    "textures": { "side": "bellows_side", "top": "bellows_top", "bottom": "bellows_side" }
  },
  "bellows": true,
  "sink": 0.5,
  "occludes": false,
  "hardness": 6,
  "sfx": "hit_wood"
}
